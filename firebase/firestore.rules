rules_version = '2';
// Tony Khan Simulator online leagues (2–4 GMs, seats s0–s3).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function seatKey(code, seat) {
      return get(/databases/$(database)/documents/games/$(code)/seats/$(seat)).data.key;
    }

    // Cloud saves. The 12-character sync code is the key: only someone who has it can open the save,
    // and saves can't be listed or searched.
    match /saves/{id} {
      allow get, create, update: if signedIn() && id.size() == 12;
      match /backups/{slot} {
        allow get, create, update: if signedIn() && id.size() == 12 && slot in ['b0', 'b1', 'b2', 'b3', 'b4'];
      }
    }

    match /games/{code} {
      function uidsBefore() { return resource.data.uids; }
      function uidsAfter() { return request.resource.data.uids; }
      function isMember() { return request.auth.uid in uidsBefore().values(); }
      function onlySeatChanged(k) { return uidsAfter().diff(uidsBefore()).affectedKeys().hasOnly([k]); }
      function sameLeague() { return request.resource.data.n == resource.data.n; }
      // a friend taking an open seat
      function joins(k) {
        return k in uidsBefore() && uidsBefore()[k] == null && uidsAfter()[k] == request.auth.uid
          && onlySeatChanged(k) && !isMember();
      }
      // moving your own seat to a new device with its private seat code
      function claims(k) {
        return k in uidsBefore() && uidsAfter()[k] == request.auth.uid && onlySeatChanged(k)
          && request.resource.data.claim == seatKey(code, k);
      }

      // Anyone signed in to the app who knows the code can see the league.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.n in [2, 3, 4]
        && request.resource.data.uids.s0 == request.auth.uid;

      allow update: if signedIn() && sameLeague() && (
        (isMember() && uidsAfter() == uidsBefore())   // a GM taking their turn
        || joins('s1') || joins('s2') || joins('s3')
        || claims('s0') || claims('s1') || claims('s2') || claims('s3')
      );

      // Private seat codes: written by the seat's owner, never readable by the app.
      match /seats/{seat} {
        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/games/$(code)).data.uids[seat] == request.auth.uid;
      }

      // Each device's push token; only the Cloud Function reads these.
      match /tokens/{uid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
